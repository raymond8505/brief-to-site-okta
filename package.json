{
  "name": "brief-to-site",
  "version": "0.0.0",
  "private": true,
  "description": "AI Sales Microsite Tool — brief + brand colour(s) → SSR microsite → multi-viewport screenshots.",
  "packageManager": "yarn@4.17.0",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/core",
    "sites:new": "tsx packages/core/src/config/cli/new-site.ts",
    "sites:validate": "tsx packages/core/src/config/cli/validate.ts",
    "sites:dev": "tsx packages/core/src/config/cli/dev-site.ts",
    "theme:build": "tsx packages/core/src/config/cli/theme-build.ts",
    "placeholders:copy": "tsx packages/core/src/config/cli/placeholders-copy.ts",
    "capture:run": "tsx scripts/capture-run.ts",
    "storybook": "yarn workspace @brief-to-site/core storybook",
    "build-storybook": "yarn workspace @brief-to-site/core build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-plugin-storybook": "^10.4.1",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "4.1.9"
  }
}
