{
  "name": "brief-to-site",
  "version": "0.0.0",
  "private": true,
  "description": "AI Sales Microsite Tool — brief + brand colour(s) → SSR microsite → multi-viewport screenshots.",
  "packageManager": "yarn@4.17.0",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:core": "eslint packages/core",
    "typecheck": "tsc -p tsconfig.scripts.json && yarn workspaces foreach -A -p --exclude brief-to-site run typecheck",
    "typecheck:core": "tsc -p packages/core",
    "sites:new": "tsx packages/core/src/config/cli/new-site.ts",
    "sites:validate": "tsx packages/core/src/config/cli/validate.ts",
    "config:schema": "tsx packages/core/src/config/cli/schema.ts",
    "sites:dev": "tsx packages/core/src/config/cli/dev-site.ts",
    "sites:novel": "tsx packages/core/src/config/cli/novel-list.ts",
    "theme:build": "tsx packages/core/src/config/cli/theme-build.ts",
    "placeholders:build": "tsx scripts/placeholder-gen.ts",
    "placeholders:source": "tsx scripts/placeholder-source.ts",
    "capture:run": "tsx scripts/capture-run.ts",
    "storybook": "yarn workspace @brief-to-site/core storybook",
    "build-storybook": "yarn workspace @brief-to-site/core build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^1.0.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-plugin-storybook": "^10.4.1",
    "husky": "^9.1.7",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "4.1.9"
  }
}
