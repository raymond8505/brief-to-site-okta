# Environment configuration for brief-to-site.
# Copy to `.env` and fill in as needed. Everything here is OPTIONAL — the core pipeline
# (scaffold → author → assemble → theme:build → placeholders:build → capture) needs no keys.

# Unsplash access key — ONLY needed for the optional `yarn placeholders:source <slug>` step,
# which auto-fills a site's placeholders with real stock photos from their manifest descriptions.
# Register a free app at https://unsplash.com/developers to get an Access Key (no secret needed).
UNSPLASH_ACCESS_KEY=
